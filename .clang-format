# Default C/C++ style, used by conform when a project has no .clang-format of its own
BasedOnStyle: LLVM
BreakBeforeBraces: Allman
IndentWidth: 4
AllowShortFunctionsOnASingleLine: Empty  # keep empty bodies as `Foo() {}`
AllowShortBlocksOnASingleLine: Never
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
